# VECTRON configuration
# Copy this file to .env and set your own credentials.
# Never commit .env or real API keys.

# Google AI Studio / Gemini (required for model-backed image-document parsing)
GOOGLE_API_KEY=your_google_ai_studio_key_here
GOOGLE_GENAI_USE_ENTERPRISE=0

# Model IDs must be available to your Google AI Studio account.
PRIMARY_MODEL=gemini-2.0-flash
FALLBACK_PRIMARY_MODEL=gemini-3.8-flash

# Timeout / performance settings (targets, not guarantees)
TARGET_LATENCY_MS=350
MAX_LATENCY_THRESHOLD_MS=1200
FAST_CACHE_ENABLED=true

# Recovery policy
MAX_RETRIES=3
BACKOFF_MS=25

# Local server ports
API_PORT=8000
MCP_SERVER_PORT=8001
