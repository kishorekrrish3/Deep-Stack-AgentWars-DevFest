# Google AI Studio API Key (Free Tier: strictly $0.00)
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_USE_ENTERPRISE=0

# Primary Model Selection (gemini-2.0-flash or auto-fallback to gemini-3.8-flash)
PRIMARY_MODEL=gemini-2.0-flash
FALLBACK_PRIMARY_MODEL=gemini-3.8-flash

# Groq Cloud Free Tier API Key (Optional secondary fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.2-11b-vision-preview

# Performance SLA & Timeouts (Target: < 350ms turn-around latency)
TARGET_LATENCY_MS=350
MAX_LATENCY_THRESHOLD_MS=1200
FAST_CACHE_ENABLED=true
MCP_SERVER_PORT=8001
API_PORT=8000
